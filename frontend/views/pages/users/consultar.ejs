<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<h1>Consultar Usuarios</h1>
<table id="searchUser" class="display">
    <thead>
        <tr>
            <th>Correo</th>
            <th>Rol</th>
            <th>Cédula</th>
            <th>Habilitado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        <% usuarios.forEach(usuario => { %>
            <tr>
                <td><%= usuario.correo %></td>
                <td><%= usuario.rol %></td>
                <td><%= usuario.cedula %></td>
                <td><%= usuario.habilitado %></td>
                <td>
                    <button class="edit-btn">Editar</button>
                    <button class="delete-btn">Eliminar</button>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
<script>
    $(document).ready(function() {
        $('#searchUser').DataTable({
            paging: true,         // Habilita la paginación
            searching: true,      // Habilita la búsqueda
            ordering: false,       // Habilita la ordenación
            info: true,           // Muestra información

            
            lengthChange: true,   // Permite cambiar la longitud de la página
            pageLength: 10,       // Longitud de página predeterminada
            lengthMenu: [[5, 10, 25, 50, 100], [5, 10, 25, 50, 100]], // Opciones de longitud de página
            buttons: [            // Botones para exportar datos
                {
                extend: 'print',
                text: 'Imprimir',
                exportOptions: {
                    columns: ':not(:eq(4))' // Omitir la quinta columna
                }
            },
            {
                extend: 'copy',
                text: 'Copiar',
                exportOptions: {
                    columns: ':not(:eq(4))' // Omitir la segunda columna
                }
            },
            {
                extend: 'excel',
                text: 'Excel',
                exportOptions: {
                    columns: ':not(:eq(4))' // Omitir la segunda columna
                }
            },
            {
                extend: 'pdf',
                text: 'PDF',
                exportOptions: {
                    columns: ':not(:eq(4))' // Omitir la segunda columna
                }
            }
            ],
            dom: 'Bfrtlip', 
            language: {
                url: 'https://cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json'
            }
        });
    });
</script>
<%- include('../../partials/footer') %>
