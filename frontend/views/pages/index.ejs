<%- include('../partials/head') %>
<header>
    <nav>
        <div id="nav-right">
            <button class="modalBtn" id="loginButton">Iniciar Sesión</button>
            <button class="modalBtn" id="registerButton">Registrarse</button>
        </div>
    </nav>
</header>

<div id="loginModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Iniciar Sesión</h2>
        <form id="loginForm" action="/login" method="POST">
        <label for="correo">Correo:</label>
        <input type="email" id="correo" name="correo" required>

        <label for="pass">Contraseña:</label>
        <input type="pass" id="pass" name="pass" required>
        
        <button type="submit">Iniciar Sesión</button>
        </form>
        <div class="register-option">
            <p>¿No tienes cuenta? <a href="#" id="registerLink">Regístrate aquí</a></p>
            <p><a href="#">¿Olvidaste tu contraseña?</a></p>
          </div>
    </div>
</div>

